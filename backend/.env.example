# Database.
# Local dev: SQLite (default). Production: Supabase Postgres connection
# string. Use the Transaction pooler DSN (port 6543) so Render's free
# plan does not run out of direct connections; app/database.py applies
# the pooler-safe engine settings automatically.
DATABASE_URL=sqlite:///./disclosure_scorer.db

SPACY_MODEL=en_core_web_sm

# Tesseract OCR on native platforms. Leave UNSET on Linux (incl. Docker
# and Render) — the system `tesseract` on PATH is picked up by
# pytesseract; traineddata lives at /usr/share/tesseract-ocr/4.00/tessdata.
# On Windows point at the Program Files install if ara.traineddata was
# dropped into a user-writable TESSDATA_PREFIX.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=E:\path\to\repo\backend\tessdata

OCR_LANGS=eng+ara
MATCHING_MODE=longest

# Contact email published to sites we crawl. Required by CLAUDE.md rule 5.
# VERITY_CONTACT_EMAIL=you@example.com

# Cloudflare R2 (S3-compatible object storage) credentials. Required in
# production; omit locally to fall back to the on-disk storage_dir path.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=verity-reports

# CORS allow-list, comma-separated. On Render set this to the Vercel URL
# (and any preview-deploy URL you want to admit). Leave blank locally to
# fall back to http://localhost:5173 (the Vite dev server).
# ALLOWED_ORIGINS=https://verity.vercel.app
