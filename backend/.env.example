DATABASE_URL=sqlite:///./disclosure_scorer.db
SPACY_MODEL=en_core_web_sm

# Windows: point at the exe and the user-writable tessdata folder if
# tesseract is installed in Program Files but you can't (or won't) drop
# ara.traineddata into a protected path. Copy eng.traineddata alongside
# ara.traineddata into TESSDATA_PREFIX.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=E:\path\to\repo\backend\tessdata

OCR_LANGS=eng+ara
MATCHING_MODE=longest

# Contact email published to sites we crawl. Required by CLAUDE.md rule 5.
# VERITY_CONTACT_EMAIL=you@example.com
