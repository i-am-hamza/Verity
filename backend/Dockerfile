# Backend container for Render deployment.
#
# Build context expected to be the REPO ROOT (not backend/), because the
# scoring pipeline reads config/verity.toml and data/*.json via a
# relative path that assumes the backend/ sibling layout (see
# app/services/verity_config.py Path.parents[3] logic). render.yaml
# sets dockerContext: . and dockerfilePath: ./backend/Dockerfile.
#
# Why Docker instead of Render's native Python buildpack:
#   The scoring pipeline uses Tesseract (eng + ara) for scanned-page
#   fallback OCR. The native buildpack cannot install system apt
#   packages, which is exactly what tesseract-ocr + tesseract-ocr-ara
#   are. With Docker we control the full base image and can `apt-get
#   install` tesseract reliably at build time.
#
# Base image: python:3.12-slim-bookworm (Debian 12). Slim variant drops
# docs/caches but keeps the full Python stdlib and build toolchain for
# wheels; bookworm's tesseract-ocr-ara is 4.1.1 which is what the local
# dev environment also runs against.

FROM python:3.12-slim-bookworm

# --- system dependencies --------------------------------------------------
#
# tesseract-ocr          : the OCR binary pytesseract shells out to
# tesseract-ocr-eng      : English traineddata
# tesseract-ocr-ara      : Arabic traineddata (CLAUDE.md: MENA reports
#                          are bilingual; eng+ara is the default
#                          OCR_LANGS in settings)
# libgl1 / libglib2.0-0  : runtime deps pulled in by pymupdf's bundled
#                          rendering backend when generating page
#                          pixmaps for the OCR fallback path
# curl                   : used by the HEALTHCHECK below
#
# `--no-install-recommends` keeps the layer slim; the final
# `rm -rf /var/lib/apt/lists/*` shaves another ~30 MB off the image.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      tesseract-ocr \
      tesseract-ocr-eng \
      tesseract-ocr-ara \
      libgl1 \
      libglib2.0-0 \
      curl \
 && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# /app = repo root inside the container. backend/ is a sibling of
# config/ and data/, matching the host layout.
WORKDIR /app

# Install Python deps first so a change to app code doesn't invalidate
# the (expensive) wheel + spacy-model layer. requirements.txt is the
# only thing we need for `pip install`.
COPY backend/requirements.txt backend/requirements.txt
RUN pip install --upgrade pip \
 && pip install -r backend/requirements.txt \
 && python -m spacy download en_core_web_sm

# Application code + the sibling directories the code reads from.
COPY backend/app ./backend/app
COPY backend/alembic ./backend/alembic
COPY backend/alembic.ini ./backend/alembic.ini
COPY config ./config
COPY data ./data
# docs/ and exports/ are runtime inputs for the dashboard:
#   docs/METHODOLOGY.md         -> GET /dashboard/methodology
#   docs/SENSITIVITY_SUMMARY.md -> GET /dashboard/sensitivity  (headline stats)
#   exports/sensitivity_summary.csv -> GET /dashboard/sensitivity  (rows)
# Without these the sensitivity route 404s and methodology returns a
# placeholder stub. .dockerignore keeps them in the build context.
COPY docs ./docs
COPY exports ./exports

# End-to-end OCR smoke test at build time. Shells into Python and
# synthesises a tiny image with the word "DISCLOSURE" rendered on it,
# then shells back out through pytesseract exactly the way
# app/services/pdf_extraction.py does when a scanned page is detected.
# Fails the build if (a) tesseract-ocr is missing, (b) eng traineddata
# is missing, (c) pytesseract can't find the binary, OR (d) the OCR
# round-trip produces nothing recognisable. We check for the substring
# "DISCLOSURE" (case-insensitive) because tesseract's confidence on a
# toy image is not perfect, but it is consistent enough on a word this
# obvious that a soft match catches real breakage without flapping on
# anti-aliasing noise.
#
# Verifies ara traineddata is also present via --list-langs: synthesising
# Arabic rendering here would need a font the slim base image doesn't
# ship by default. The real Arabic path runs on PDF pixmaps generated by
# PyMuPDF at request time, which embed their own fonts.
RUN tesseract --version \
 && tesseract --list-langs 2>&1 | tee /tmp/langs.txt \
 && grep -qx "ara" /tmp/langs.txt \
 && grep -qx "eng" /tmp/langs.txt \
 && python - <<'PY'
import sys
from PIL import Image, ImageDraw, ImageFont
import pytesseract

# Pillow 10.1+ ships DejaVu Sans embedded, so load_default(size=...)
# gives us a readable TTF without needing apt fonts-dejavu. Tesseract
# chokes on the 10 px fallback bitmap font that older load_default
# returns.
font = ImageFont.load_default(size=48)
img = Image.new("RGB", (640, 100), color="white")
ImageDraw.Draw(img).text((20, 20), "DISCLOSURE", fill="black", font=font)
text = pytesseract.image_to_string(img, lang="eng").strip()
print(f"OCR smoke output: {text!r}")
if "disclosure" not in text.lower():
    print("OCR smoke test FAILED: tesseract did not recognise 'DISCLOSURE'",
          file=sys.stderr)
    sys.exit(1)
print("OCR smoke test OK")
PY

# Render injects PORT at container start. Default to 8000 for local
# `docker run` convenience.
ENV PORT=8000

# Run uvicorn from inside backend/ so `app.main:app` resolves without
# any PYTHONPATH gymnastics.
WORKDIR /app/backend

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${PORT}/health" || exit 1

EXPOSE 8000

# Shell form so ${PORT} is expanded at container-start time by sh.
CMD uvicorn app.main:app --host 0.0.0.0 --port ${PORT}
