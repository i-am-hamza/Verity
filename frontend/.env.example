# Base URL of the Verity API.
#
# Local development: leave this unset. The Vite dev server (vite.config.ts)
# proxies "/api/*" to http://localhost:8000, so the client's default of
# "/api" works out of the box.
#
# Production (Vercel): set VITE_API_URL to the deployed Render URL, e.g.
#   VITE_API_URL=https://verity-api.onrender.com
# Vite inlines import.meta.env.VITE_* at build time, so this is read when
# `npm run build` runs on Vercel, not at runtime.
# VITE_API_URL=
