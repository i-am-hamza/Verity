# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment / secrets
.env

# SQLite
*.db
*.db-journal

# Storage: uploaded PDFs and any derived artefacts stay out of git.
backend/storage/
# Root-level storage/ drop-box for new PDFs before ingest (Phase 1 onward).
storage/
backend/tessdata/*.traineddata

# Real fixtures (downloaded PDFs — content, not the manifest).
backend/tests/fixtures/real/*.pdf
backend/tests/fixtures/real/*.PDF

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local AI-assistant workspace (per-user, not source).
.claude/
CLAUDE.md

# Frontend build
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo
frontend/vite_dev.log

# Playwright verification screenshots — large binary artefacts, regenerated
# by `node frontend/scripts/screenshots.mjs` whenever needed. The script
# itself is committed; the output is not.
frontend/screenshots/
frontend/playwright-report/
frontend/test-results/

# Session artefacts / temp outputs
_*.log
backend/_*.log
backend/_*.json
backend/_openapi.json
frontend/_openapi.json
coverage/
*.coverage

# Board-pages text + per-company reader output. Both are materialised from
# R2 PDFs for the researcher-review loop; neither is source-of-truth.
data/board_pages/
data/board_pages_out/

# Researcher dropbox and derived analysis outputs. Inputs are copied into
# analysis/data/ (committed) when they land; the raw dropbox and the
# regeneratable results stay untracked.
incoming/
analysis/results/

